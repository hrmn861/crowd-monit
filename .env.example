# DATABASE_URL: PostgreSQL connection string (Docker default: postgresql://postgres:postgrespassword2026@postgres:5432/crowdmonitor)
# Falls back to sqlite:///./crowd_monitor.db if not specified
DATABASE_URL="postgresql://postgres:postgrespassword2026@localhost:5432/crowdmonitor"

# JWT_SECRET_KEY: Secret key for signing and validating HS256 operator JWT tokens
JWT_SECRET_KEY="crowd-monitor-production-super-secret-jwt-key-2026"

# SMTP EMAIL DISPATCH CONFIGURATION (SendGrid, AWS SES, Gmail, Mailgun, or corporate relay)
# Used to dispatch real-time crowd surge escalation summaries to control room addresses
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="YOUR_SENDGRID_OR_SMTP_PASSWORD"
SMTP_FROM_EMAIL="alerts@crowdmonitor.io"
CONTROL_ROOM_EMAILS="harmanpreet7012@gmail.com,dispatch-center@crowdmonitor.io"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
